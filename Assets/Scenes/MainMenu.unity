MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 659215121}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c997c55315073f748ab8abe1cc73490d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MainMenuUI
  gameTitle: OPERASI SENYAP
  subtitle: Stealth Infiltration
  credits: 'Aset: Quaternius & KayKit (CC0)  |  Font: Rajdhani (OFL)  |  Audio: sintesis
    prosedural'
  levels:
  - sceneName: Level0_Tutorial
    title: Simulasi Akademi Agen
    description: 'Simulasi terakhir sebelum operasi pertamamu: keycard & pintu, obeng
      & ventilasi, dan menyelinap melewati penjaga latihan.


      1 penjaga latihan 
      -  1 kamera CCTV

      Wajib bagi agen baru.'
    difficulty: 1
  - sceneName: Level1_SecurityCheckpoint
    title: Pos Keamanan Sektor 7
    description: 'Curi Keycard Merah, retas terminal server, lalu kabur lewat Gerbang
      Timur.


      3 prajurit  -  1 kamera CCTV

      Cocok untuk belajar jongkok,
      lempar kaleng & panel listrik.'
    difficulty: 1
  - sceneName: Level2_ResearchLab
    title: Laboratorium Riset Bawah Tanah
    description: 'Cari obeng, merangkak lewat ventilasi, curi Prototipe X-7 dari
      brankas.


      5 prajurit  -  2 kamera CCTV

      Kamera mengawasi jalur
      utama lab.'
    difficulty: 2
  - sceneName: Level_Adaptive
    title: Operasi Adaptif (Prosedural)
    description: 'Fasilitas dibangun ulang setiap run (PCG). Jumlah prajurit, CCTV,
      cover & perilaku AI menyesuaikan performamu (DDA + ML).


      Tanpa akhir
      - semakin jago, semakin sulit.

      F2 panel AI  -  F3 peta validasi.'
    difficulty: 3
