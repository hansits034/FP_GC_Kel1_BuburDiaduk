  m_Script: {fileID: 11500000, guid: 244f236e80b8f0c44a5cd252cd6537c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  levelTitle: LEVEL 1 - Pos Keamanan Sektor 7
  briefing: 'Susupi pos keamanan militer, curi data patroli dari Ruang Server, lalu
    kabur lewat Gerbang Timur.

    Jongkok (Ctrl) di balik karung pasir, lempar
    kaleng untuk mengalihkan prajurit. Jangan sampai tertangkap!'
  steps:
  - key: pickup:keycard_red
    description: Ambil Keycard Merah di Ruang Jaga
    target: {fileID: 993219041}
    optional: 0
  - key: open:door_server
    description: Buka pintu Ruang Server
    target: {fileID: 1743079349}
    optional: 0
  - key: use:terminal_server
    description: Unduh data patroli di terminal (tahan E)
    target: {fileID: 329114073}
    optional: 0
  - key: extract
    description: Kabur ke Gerbang Timur
    target: {fileID: 863718000}
    optional: 0
  - key: pickup:can
    description: Ambil kaleng untuk pengalih perhatian
    target: {fileID: 1016007690}
    optional: 1
  - key: use:power_hall
    description: Matikan listrik Aula dari panel di Gudang
    target: {fileID: 1439068491}
    optional: 1
