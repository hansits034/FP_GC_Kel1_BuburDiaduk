MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 381759013}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 244f236e80b8f0c44a5cd252cd6537c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  levelTitle: LEVEL 2 - Laboratorium Riset Bawah Tanah
  briefing: 'Prototipe X-7 disimpan di Brankas. Keycard Biru ada di Ruang Kepala
    Lab yang hanya bisa dicapai lewat ventilasi.

    Cari obeng, merangkak lewat
    ventilasi, curi prototipe, lalu kabur lewat Lift Darurat. Awas kamera keamanan!'
  steps:
  - key: pickup:screwdriver
    description: Cari obeng di Gudang
    target: {fileID: 164667594}
    optional: 0
  - key: open:vent_storage
    description: Buka baut ventilasi di Gudang (tahan E)
    target: {fileID: 503222070}
    optional: 0
  - key: pickup:keycard_blue
    description: Merangkak lewat ventilasi (Ctrl) & ambil Keycard Biru
    target: {fileID: 336490306}
    optional: 0
  - key: open:door_vault
    description: Buka Pintu Brankas di ujung Lab Utama
    target: {fileID: 1878122804}
    optional: 0
  - key: pickup:prototype
    description: Curi Prototipe X-7
    target: {fileID: 40326079}
    optional: 0
  - key: extract
    description: Kabur lewat Lift Darurat
    target: {fileID: 945018036}
    optional: 0
  - key: use:power_lab
    description: Matikan lampu & kamera dari panel listrik Gudang
    target: {fileID: 168624134}
    optional: 1
  - key: pickup:can
    description: Kumpulkan kaleng untuk pengalih perhatian
    target: {fileID: 1489469331}
    optional: 1
