  m_Script: {fileID: 11500000, guid: 0ce4b82cc3b84124796a5880e8e318ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrainingTip
  title: Melempar Kaleng
  body: 'Sembunyi di balik karung pasir, lalu <color=#ffd36a>KLIK KIRI</color> untuk
    melempar kaleng ke arah kursor mouse. Lempar ke dekat penjaga tapi jauh dari
    jalurmu: ia akan menoleh atau datang memeriksa bunyinya. Saat itulah menyelinap
    ke titik ekstraksi. Lolos tanpa sekali pun ketahuan = peringkat HANTU.'
  requiredItemId: can
  areaSize: {x: 12, y: 4, z: 9}
