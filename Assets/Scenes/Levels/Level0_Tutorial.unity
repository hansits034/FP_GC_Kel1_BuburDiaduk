MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 804641722}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 244f236e80b8f0c44a5cd252cd6537c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionManager
  levelTitle: PELATIHAN - Simulasi Akademi Agen
  briefing: 'Agen baru, ini simulasi terakhir sebelum operasi pertamamu. Instruktur
    menyiapkan pintu berkunci, ventilasi, dan penjaga latihan.

    Perhatikan senter
    penjaga: kuning = curiga, oranye = mencari, merah = kamu ketahuan!'
  steps:
  - key: pickup:keycard_red
    description: 'Latihan 1: Ambil Keycard Merah dari meja instruktur (E)'
    target: {fileID: 869968574}
    optional: 0
  - key: open:door_training
    description: 'Latihan 1: Buka pintu gudang memakai keycard'
    target: {fileID: 584106993}
    optional: 0
  - key: pickup:can
    description: 'Latihan 2: Ambil kaleng - klik kiri untuk melempar pengalih'
    target: {fileID: 30737658}
    optional: 0
  - key: pickup:screwdriver
    description: 'Latihan 2: Ambil obeng dari peti perlengkapan'
    target: {fileID: 1747487416}
    optional: 0
  - key: open:vent_tutorial
    description: 'Latihan 3: Buka baut ventilasi (tahan E)'
    target: {fileID: 1525841853}
    optional: 0
  - key: extract
    description: 'Latihan 4: jongkok (Ctrl) lewat ventilasi, lolos dari penjaga,
      capai titik ekstraksi'
    target: {fileID: 1136693386}
    optional: 0
  - key: use:power_tutorial
    description: 'Ujian Akhir: padamkan lampu, kamera, dan gas dari panel listrik'
    target: {fileID: 1433495009}
    optional: 0
