  m_Script: {fileID: 11500000, guid: 0ce4b82cc3b84124796a5880e8e318ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrainingTip
  title: Panel Listrik & CCTV
  body: Kamera CCTV di sudut arena memanggil penjaga jika melihatmu. Tekan <color=#ffd36a>E</color>
    pada panel ini untuk memadamkan kamera, lampu, dan gas ventilasi sisi barat arena
    selama 20 detik. Di tempat gelap kamu sulit terlihat, tapi area di dekat penjaga
    tetap terang - untuk melewatinya kamu tetap butuh kaleng.
  requiredItemId: 
  areaSize: {x: 3, y: 4, z: 2.6}
