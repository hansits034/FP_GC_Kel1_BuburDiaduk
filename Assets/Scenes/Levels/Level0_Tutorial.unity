  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrainingTip
  title: Gerak Senyap
  body: 'Berjalan menimbulkan suara kecil, berlari (<color=#ffd36a>SHIFT</color>)
    jauh lebih berisik - lingkaran putih di lantai menunjukkan jangkauan suaramu.
    Tekan <color=#ffd36a>CTRL</color> untuk jongkok: langkahmu nyaris tanpa suara
    dan kamu bisa bersembunyi di balik cover rendah seperti karung pasir ini.'
  requiredItemId: 
  areaSize: {x: 6, y: 4, z: 5}
